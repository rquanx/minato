FROM ghcr.io/berriai/litellm:v1.85.0@sha256:2e8517e2bed423c50ab7e40fb1ac0a9cbe62a764e9d65161d871fb6a9bf75a2d AS upstream
FROM caddy:2.10.2-alpine
COPY --from=upstream /app/litellm/proxy/_experimental/out/ /srv/litellm/
COPY --from=upstream /app/LICENSE /srv/litellm-license.txt
COPY deploy/Caddyfile.litellm-ui /etc/caddy/Caddyfile
