POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://minato:change-this-local-password@postgres:5432/minato
LITELLM_DATABASE_URL=postgresql://minato:change-this-local-password@postgres:5432/minato?schema=litellm
MINATO_ADMIN_PASSWORD=
MINATO_KEY_PEPPER=
MINATO_AUDIT_SECRET=
# Optional separate encryption key for imported provider credentials (32+ characters).
# When omitted, Minato uses MINATO_AUDIT_SECRET.
# MINATO_CREDENTIAL_SECRET=
MINATO_CALLBACK_SECRET=
MINATO_RUNTIME_TOKEN=
# Optional separate credential for route publication.
# MINATO_RUNTIME_PUBLISH_TOKEN=
# Optional comma-separated Runtime replica URLs used for route publication.
# MINATO_RUNTIME_PUBLISH_URLS=http://runtime-1:4300,http://runtime-2:4300
MINATO_COOKIE_SECURE=false
MINATO_PUBLIC_ORIGIN=http://localhost:8088
MINATO_PUBLIC_PORT=8088
LITELLM_MASTER_KEY=
# Optional hybrid deployment settings.
# LITELLM_CONFIG_DIR=./deploy
# MINATO_UPSTREAM_LITELLM=<LiteLLM virtual key scoped to the compatibility models>
